<odoo>
  <data>
    <record model="ir.ui.view" id="dhl_methods.list">
      <field name="name">Metodos de envío de DHL</field>
      <field name="model">dhl.shipping.methods</field>
      <field name="arch" type="xml">
        <list string="Metodos de envío de DHL">
          <field name="purchase_order"/>
          <field name="name"/>
          <field name="dhl_code"/>
          <field name="price"/>
          <field name="weight"/>
          <field name="origin"/>
          <field name="destination"/>
          <field name="requestDate"/>
        </list>
      </field>
    </record>
  </data>
</odoo>