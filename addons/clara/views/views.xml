<odoo>
  <data>

    <record model="ir.ui.view" id="clara.list">
      <field name="name">Clara</field>
      <field name="model">clara.move</field>
      <field name="arch" type="xml">
        <list>
          <field name="uuid"/>
          <field name="type"/>
          <field name="transaction_label"/>
          <field name="status"/>
          <field name="comment"/>
          <field name="authorization_number"/>
          <field name="installment"/>
          <field name="installment_number"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="clara.form">
      <field name="name">Clara Form</field>
      <field name="model">clara.move</field>
      <field name="arch" type="xml">
      <form string="Clara">
        <group>
          <field name="uuid"/>
          <field name="type"/>
          <field name="transaction_label"/>
          <field name="status"/>
          <field name="comment"/>
          <field name="authorization_number"/>
          <field name="installment"/>
          <field name="installment_number"/>
          <field name="billing_statement_uuid"/>
          <field name="billing_period_start_date"/>
          <field name="billing_period_end_date"/>
          <field name="audit_accounting_date"/>
          <field name="audit_operation_date"/>
          <field name="audit_last_update_date"/>
          <field name="merchant_name"/>
          <field name="merchant_mcc"/>
          <field name="merchant_description"/>
          <field name="merchant_category"/>
          <field name="merchant_category_code"/>
          <field name="card_uuid"/>
          <field name="card_masked_pan"/>
          <field name="user_uuid"/>
          <field name="user_holder_name"/>
          <field name="original_amount_currency"/>
          <field name="original_amount_value"/>
          <field name="amount_value_currency"/>
          <field name="amount_value_amount"/>
          <field name="validation_status"/>
          <field name="validation_comment"/>
          <field name="has_invoice"/>
          <field name="has_attachments"/>
          <field name="bank_concept_number"/>
          <field name="bank_concept_description"/>
          <field name="description"/>
        </group>
      </form>
      </field>
    </record>

    <record id="action_clara" model="ir.actions.act_window">
      <field name="name">Clara</field>
      <field name="res_model">clara.move</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="clara.list"/>
    </record>

    <menuitem id="menu_clara" name="Clara" action="action_clara"/>
  </data>
</odoo>