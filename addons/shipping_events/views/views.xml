<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="shipping_events_list">
      <field name="name">Eventos del Envío</field>
      <field name="model">shipping.events</field>
      <field name="arch" type="xml">
        <list>
          <field name="date"/>
          <field name="time"/>
          <field name="name"/>
        </list>
      </field>
    </record>
   
  <record id="action_events_view" model="ir.actions.act_window">
        <field name="name">Eventos del Envío</field>
        <field name="res_model">shipping.events</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- Vista de árbol para shipping.events -->
    <record id="view_events_list" model="ir.ui.view">
        <field name="name">shipping.events.list</field>
        <field name="model">shipping.events</field>
        <field name="arch" type="xml">
            <list>
              <field name="date"/>
              <field name="time"/>
              <field name="code"/>
              <field name="name"/>
            </list>
        </field>
    </record>


