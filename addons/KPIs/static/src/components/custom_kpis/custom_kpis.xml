<t t-name="custom_kpis.Template">
    <div class="custom-kpis-view">
        <div class="header">
            <h1>KPIs Surtidos</h1>
        </div>
        <div class="filters">
            <div class="filter-item">
                <label for="date">Fecha:</label>
                <input type="date" id="date" t-att-value="state.date" t-on-change="onDateChange"/>
            </div>
        </div>
        <div class="kpi-container">
            <div class="kpi-line">
                <div class="kpi-item">
                    <h2>Ordenes Recibidas (Ayer)</h2>
                    <div t-esc="state.registrosAyer.length"></div>
                </div>
                <div class="kpi-item">
                    <h2>Ordenes Surtidas (Ayer)</h2>
                    <div t-esc="state.surtidasAyer.length"></div>
                </div>
                <div class="kpi-item">
                    <h2>Ordenes Pendientes</h2>
                    <div t-esc="state.registrosAyer.length - state.surtidasAyer.length"></div>
                </div>
            </div>
            <div class="kpi-line">
                <div class="kpi-item">
                    <h2>Ordenes con Retraso</h2>
                    <div t-esc="state.retrasoHoy.length"></div>
                </div>
                <div class="kpi-item">
                    <h2>Ordenes OTIF</h2>
                    <div t-esc="state.otifHoy.length"></div>
                </div>
                <div class="kpi-item">
                    <h2>OTIF (%)</h2>
                    <div t-esc="state.registrosAyer.length"></div>
                </div>
            </div>
        </div>
    </div>
</t>
