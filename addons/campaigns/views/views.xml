<odoo>
  <data>

    <record model="ir.ui.view" id="campaigns.list">
      <field name="name">Campañas</field>
      <field name="model">purchase.campaigns</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="start"/>
          <field name="end"/>
          <field name="active"/>
          <field name="product_ids"/>
        </list>
      </field>
    </record>
    
    <record model="ir.ui.view" id="campaigns.form">
      <field name="name">Campañas</field>
      <field name="model">purchase.campaigns</field>
      <field name="arch" type="xml">
        <form string="Campañas">
          <group>
            <field name="name"/>
            <field name="start"/>
            <field name="end"/>
            <field name="active"/>
            <field name="product_ids"/>
          </group>
        </form>
      </field>
    </record>

    <record id="action_campaigns" model="ir.actions.act_window">
      <field name="name">Campañas</field>
      <field name="res_model">purchase.campaigns</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_campaigns" name="Campañas" action="action_campaigns"/>
  </data>
</odoo>