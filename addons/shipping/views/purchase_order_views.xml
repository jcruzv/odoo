<odoo>
    <record id="view_purchase_order_form_inherit_shipping" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.shipping</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Botón para solicitar cotización -->
                <button name="request_shipping_quote"
                        string="Solicitar Cotización"
                        type="object"
                        class="btn-primary"/>
                <!-- Botón para generar la orden de shipping -->
                <button name="generate_shipping_order"
                        string="Generar Orden de Envío"
                        type="object"
                        class="btn-success"/>
                        
                <button name="get_shipping_events_action"
                        string="Ver Actualizaciones"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="requestShipping"/>
            </xpath>
            
            <xpath expr="//form[1]/sheet[1]/group[1]" position="after">
                <group name="studio_group_5gl_1ij6vloq3" string="Detalles del envío" invisible="requestShipping != True">
                <group name="studio_group_5gl_left"/>
                </group>
            </xpath>

            <xpath expr="//group[@name='studio_group_5gl_left']" position="inside">
                <field name="customer_id"/>
                <field name="campaign"/>
                <field name="shipping_date"/>
                <field name="stored_selection_options" 
                    invisible="1"
                />
                <field name="shipping_method" 
                    domain="[('purchase_order', '=', id)]"
                />
                <field name="pickup"/>
                <field name="pickup_customer_id"
                    invisible="pickup == False" 
                />
                <field name="pickup_date" 
                    invisible="pickup == False" 
                />
            </xpath>

            <xpath expr="//field[@name='date_order']" position="before">
                <!-- <field name="campaign"/> -->
                <field name="shipping_status" 
                readonly="1"
                invisible="track_number == False"/>
                <field name="track_number" 
                readonly="1"
                invisible="track_number == False"/>
                <field name="track_url"
                readonly="1"
                invisible="track_url == False"
                widget="url"/>
            </xpath>

            <xpath expr="//group[@name='studio_group_5gl_1ij6vloq3']" position="inside">
                <group name="studio_group_5gl_right"/>
            </xpath>
            <xpath expr="//group[@name='studio_group_5gl_right']" position="inside">
                <field name="weight" 
                    required="shipping_method != False"
                />
                <field name="width" 
                    required="shipping_method != False"
                />
                <field name="length" 
                    required="shipping_method != False"
                />
                <field name="height" 
                    required="shipping_method != False"
                />
                
                <field name='pesoVolumetrico' readonly="1"/>
                <field name='pesoMasa' readonly="1"/>
                <field name='pesoEnvio' readonly="1"/>
            </xpath>

            <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                <page string="Productos de la Campaña" name="studio_page_22g_1ijtl7p33" invisible="requestShipping != True">
                <group name="studio_group_22g">
                </group>
                </page>
            </xpath>

            <xpath expr="//group[@name='studio_group_22g']" position="inside">
                <h4>Productos de la campaña</h4>
                <field name="campaign_product"/>
            </xpath>
        </field>
    </record>
</odoo>
